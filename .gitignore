# Dépendances (réinstallées par `npm install` à partir de package-lock.json, qui lui est versionné)
node_modules/

# Build Vite (`npm run build`) : produit en CI pour GitHub Pages, jamais versionné
dist/
dist-ssr/
*.local

# Cache et rapports des outils (Vite, Vitest, TypeScript)
node_modules/.vite/
.vite/
coverage/
*.tsbuildinfo

# Journaux
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variables d'environnement locales (aucune n'est utilisée aujourd'hui, par précaution)
.env
.env.*
!.env.example

# macOS
.DS_Store
._*

# iCloud Drive (le projet est dans iCloud) : fichiers non téléchargés
*.icloud

# Éditeurs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp

# Claude Code : réglages personnels (CLAUDE.md, lui, est versionné)
.claude/settings.local.json
